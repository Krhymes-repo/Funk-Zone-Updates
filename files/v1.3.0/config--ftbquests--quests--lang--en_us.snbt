	quest.2B8CCCB834402F5E.quest_desc: [
		"&dInvisibility Cloak&r is a cloak that makes the wearer &ncompletely invisible&r!"
		""
		"Since mobs &o&bcannot see you&r, they &o&bcannot attack you&r. Sneak up on your enemies with it!"
	]
	quest.2BA0562F80A113A3.quest_desc: [
		"&4Cooking for Blockheads&r adds a cooking book along with a &o&bfunctional kitchen&r to Minecraft."
		""
		"Use the book or the &aCooking Table&r to find out what you can cook with what ingredients you currently have available, and start cooking immediately through a &nsingle click&r."
		""
		"The &o&bkitchen is modular&r and can be upgraded through additional blocks, allowing for &o&bexpanded storage&r, &o&binfinite water&r for crafting provided by the &9Sink&r, or efficient and delicious cooking with the &2Oven&r."
		""
		"Some people even went as far as capturing a &d&o&b&rCow in a Jar&r to provide them with &ninfinite milk&r!"
	]
	quest.2BA0562F80A113A3.quest_subtitle: "*Unlocked by completing the &b&n&oThe Food&r quest*"
	quest.2BA0562F80A113A3.title: "Welcome to &4Cooking for Blockheads"
	quest.2BCE2ABFD6434430.quest_desc: [
		"Mana Relays serve this purpose. They provide a controlled channel for mana to flow through without dissipating back into the world. Mana Relays may be linked to other relays as well as jars to provide safe transit from one place to another."
