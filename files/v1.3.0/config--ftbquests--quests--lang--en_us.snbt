	quest.3D4966BD7A313777.quest_desc: [
		"&9Valkyrie Lances&r have extended melee range by &o&b10&r blocks, making it technically a ranged weapon."
		""
		"This long-range weapon is very good for defeating &eZephyrs&r and &6Valkyrie Queens&r."
	]
	quest.3D5623255BB50B22.quest_desc: [
		"Improved &o&aSpeed&r and fuel &dEfficiency&r."
	]
	quest.3D5F0E829EE089BC.quest_desc: [
		"The Inventory Connector merges all touching inventories. This can allow a Storage Terminal to see items in more than one storage block when used in combination with an Inventory Interface. The maximum range of detection is 16 blocks."
	]
	quest.3D61E0447324CA40.quest_desc: [
		"Beyond combat, Ars Elemental gives you &aupgraded spell relays&r, &bwater automation&r, and &6elemental turrets&r that discount matching-school spells by 65%."
	]
	quest.3D61E0447324CA40.title: "&a&lAutomation and Utility"
	quest.3D7AA7C9D0EA4738.quest_desc: [
		"Item Filters are useful for determining if you only want certain items to be placed within an inventory in a connected system. For example if you had an Item Filter placed on a chest with iron ingots as a filtered item, only iron ingots would be able to be placed within that storage when using a Storage Terminal. This can allow chests to still be organized when inserting items into a system from a Storage Terminal."
	]
	quest.3D7DA9BE75600209.quest_desc: [
		"Craft a large batch of Potions!"
		""
		"Create 50 Potions."
		""
		"&cLong Playtime Quest&r"
	]
