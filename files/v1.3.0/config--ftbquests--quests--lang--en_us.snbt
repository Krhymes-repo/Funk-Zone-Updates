	quest.556719593BE58F11.title: "Ghost Type Defeater"
	quest.5593FE71219C09C4.quest_desc: [
		"&eAir Infused Turrets&r apply a 65% mana discount to Air-school spells, with combo bonuses on Spark and Discharge. A line of these turrets is one of the most efficient automated defence systems in Ars Nouveau."
	]
	quest.5593FE71219C09C4.title: "&eAir Infused Turret"
	quest.55F2C43A7F08E993.quest_desc: [
		"Keep evolving your team!"
		""
