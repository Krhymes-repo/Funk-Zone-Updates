	quest.6AC8BE0A10139EFB.quest_desc: [
		"Sophisticated Storage has several upgrades designed specifically"
		"for automating and organising your storage network."
		""
		"Key automation upgrades:"
		"• §eHopper Upgrade§r — pulls items from above and pushes them out below,"
		"  turning any storage block into a smart hopper"
		"• §ePickup Upgrade§r — automatically picks up nearby items"
		"• §eFilter Upgrade§r — controls which items can enter or exit via automation"
		""
		"§eTips:§r"
		"• The Hopper Upgrade is filter-aware — combine with a Filter Upgrade to"
		"  only pull/push specific items."
		"• Use Pickup Upgrades to collect items on the ground and directly put "
		"  them into storage — works with a Filter Upgrade"
		"• Multiple Hopper Upgrades can be installed to increase throughput rate."
	]
	quest.6AC8BE0A10139EFB.title: "Sorting and Automation Upgrades"
