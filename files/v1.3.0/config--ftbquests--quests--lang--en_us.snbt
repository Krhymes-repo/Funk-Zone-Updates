	quest.410FECFDE276A634.quest_desc: [
		"The &6Bronze Dungeon&r is a large, labyrinth-like structure composed of carved stone and sentry stone."
		""
		"This structure is often found inside of large islands with only the entrance being exposed to the air."
		""
		"It is inhabited by &o&bsentries&r, &o&bmimics&r, and the &6Bronze Dungeon&r &nboss&r, the &dSlider&r."
		""
		"Non-boss rooms contain &o&bSentries&r which attack the player. Sometimes have chests on &o&b4x4&r tables, but be careful, some of these chests are &o&bMimics&r."
		""
		"The &9Boss Room's&r walls are only minable once the &nboss&r is defeated."
	]
	quest.410FECFDE276A634.title: "&6The Bronze Dungeon"
