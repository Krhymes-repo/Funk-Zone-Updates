	]
	quest.2E5A79A6455D4D91.quest_desc: [
		"Welcome to &dFunk Zone&r: &5Shadows over Kanto&r, our friends-only Cobblemon server."
		""
		"This book has a chapter for most of the big mods in the pack. They are all optional: do whatever you like, in any order. Tick this quest to get started."
		""
		"&7Tip: the quest book button in your inventory opens this book any time."
	]
	quest.2E5A79A6455D4D91.title: "Welcome to Funk Zone!"
