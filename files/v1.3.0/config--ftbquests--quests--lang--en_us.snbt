	quest.31F387F962F721DD.quest_desc: [
		"Chests with a gold trim are &6Lootr&r chests: every player gets their own loot. Open a few on your travels."
	]
	quest.31F387F962F721DD.title: "Loot for Everyone"
	quest.320FF2FA96A244E2.quest_subtitle: "Harvest an Aechor Petal from an Aechor Plant"
	quest.3256636389163B92.quest_desc: [
		"&eInventory&r charging can be &o&bconfigured&r in the &dWireless Charging Tab&r."
		""
		"Only one &2Flux Controller&r can be &o&bconnected&r to a &o&bnetwork&r at one time. The &2Controller's&r '&cOutput&r' refers to energy outputted from the network via &6Wireless Charging&r."
		""
		"&dNetwork's&r do &nnot&r require a &2Flux Controller&r to operate."
	]
	quest.3256636389163B92.quest_subtitle: "Required to activate Cross-dimensional inventory charging"
	quest.3256636389163B92.title: "&fFlux Controller"
	quest.329788C33842D79E.quest_desc: [
		"&6Phoenix Armor&r can be found in &eGold Dungeons&r, when fully worn, this armor set allows for &dFire Resistance&r; you can &o&bswim in lava&r as well."
		""
		"Be &o&bcareful&r when standing in &9water&r, as it will turn into &0Obsidian Armor&r."
	]
	quest.329788C33842D79E.title: "Phoenix Armor Set"
	quest.32C4E734D11C5910.quest_desc: [
		"&9Max Entities&r is the amount of mobs that &o&bcan be spawned&r by a &eSpawner&r and kept. If it's only &o&b5&r &nmax entities&r when &o&b5&r mobs are already spawned &nno more&r will spawned until they're &o&bdead or moved&r."
		""
		"Each &dGhast Tear&r brings it &2up&r or &cdown&r &o&b2&r entities."
		""
		"Max of &o&b16&r entities and minimum of &o&b1&r."
	]
	quest.32C4E734D11C5910.title: "&bMax Entities"
	quest.32FAA578ECC7EA71.quest_desc: [
		"Open Crates turn the blockspace in front of them into an inventory. This can allow Storage Terminals to see all of the dropped items within that block. The Open Crate can also be used to eject items onto the ground or into something like a lava source if you are trying to sort items using filters and don't want to keep the excess ones."
	]
	quest.336A8E164B8049BE.quest_desc: [
		"Challenge powerful Pokémon!"
		""
		"Defeat a Pokémon level 60 or higher."
		""
		"&cLong Playtime Quest&r - Very challenging!"
	]
	quest.336A8E164B8049BE.title: "Ultimate Challenge"
	quest.339D5B4D3858A4E4.quest_desc: [
		"The full &eAethermancer's Set&r — &fair_hat&r, &fair_robes&r, &fair_leggings&r, &fair_boots&r. Air armor is the summoner's choice: the set gives bonuses to summons, reduced gravity, and excellent mana regen."
	]
	quest.339D5B4D3858A4E4.title: "&eAethermancer's Set"
	quest.33AF71FA47703BF2.quest_desc: [
		"&9Fluix ME Glass Cable&r is the simplest cable to make, transfers power and up to &o8&r &bChannels&r."
		""
		"It comes in &o17&r diffrent &ncolors&r, the default being &9Fluix&r, and can be dyed any color using any of the &o16&r &ndyes&r."
		""
		"You can craft &nany&r colored cable with a water bucket to &nremove&r the dye."
		""
		"You can cover the cable with wool to create &dFluix ME Covered Cable&r, and craft &7Fluix ME Smart Cable&r to get a better idea of what is going on with your &bChannels&r."
	]
	quest.33DAA61DA07D6B5E.quest_desc: [
		"Evolution is a key part of training!"
		""
		"Evolve any Pokémon once."
	]
	quest.33DAA61DA07D6B5E.title: "First Evolution"
	quest.340FEDB94D0D2C75.quest_desc: [
		"The &2Matter Cannon&r is a portable railgun, which can shoot small projectiles."
		""
		"It causes damage is based on its &nammo&r. Since it is an powered weapon, it requires charging in the &6Charger&r."
		""
		"Ammunition can be refilled in a &dME Chest&r, or &5ME IO Port&r as it functions as a single item &aStorage Cell&r, similar to &e1k ME Item Storage Cell&r"
		""
		"Its battery can hold up to &b200k&r ae and consumes &o1600&r &bAE&r per item fired. (&o+1&r item fired per &bAcceleration Card&r)"
		""
		"A a general rule heavier metals inflict more damage, and lighter non metal iems are less damaging."
	]
	quest.34129BD48206A3B1.quest_desc: [
		"Inventory Cable Connectors can be placed on the inventories to connect them to the network. This means that instead of connecting an Inventory Cable to a Inventory Connector you can directly use a Cable Connector for a singular inventory. Also using a configurator on a Cable Connector can allow you to add filters or change their priority."
		""
		"Also, placing an inventory connector cable on a beacon can allow for long distance inventory connection."
	]
	quest.341B0706250BA6E0.quest_desc: [
		"&9Blue Gummy Swet&r is a &o&bsweet-smelling&r gummy, it can be found in &o&brandom chests&r in &6Bronze&r and &3Silver&r dungeons."
		""
		"It &o&bfully restores&r the player's hunger when eaten. Very useful for &nboss fights&r."
	]
	quest.34613A30C864503C.quest_desc: [
		"Wrap up a furnace and &o&bgift it to a friend&r!"
	]
	quest.348B75655D8D84F2.quest_desc: [
		"To prepare a Parchment with a spell, design the spell within your spellbook, then place a parchment on the Scribe's Table. Sneak Right Click the table with your spell book to transfer the selected spell over to the parchment."
	]
	quest.348F1C089267D9A2.quest_desc: [
		"A &7Book of Lore&r could be read by &eRight-clicking&r."
		""
		"Placing any item native into the &o&bslot&r, the book  displays &o&binformation&r about the item."
	]
	quest.348F1C089267D9A2.quest_subtitle: "Read a Book of Lore"
	quest.34C817B72294A113.quest_desc: [
		"Those drawn to mobility and lightning turn to the sky. Craft a &fLesser Focus of Air&r at the Imbuement Chamber with 3 Air Essence, 3 Gold Ingots, an Amethyst Shard, and 5,000 source."
	]
	quest.34C817B72294A113.title: "&fLesser Focus of Air"
	quest.351A533E03528004.quest_desc: [
		"&9Water Infused Turrets&r apply a 65% mana discount to Water-school spells and trigger Focus of Water's combo effects on hit — including automatic Watery Grave application at low health thresholds."
	]
	quest.351A533E03528004.title: "&9Water Infused Turret"
	quest.355D9E5BE751A454.quest_desc: [
		"Decorative &elight source&r that can be mounted on any solid surface. Even the ceiling."
		""
		"Unlike &6Torches&r, this block is not affected by &9Water&r."
	]
	quest.356E6E859F0F142A.quest_desc: [
		"Here is the default method of converting &cRedstone Dust&r into &0Flux&r."
		""
		"&bStep 1:&r Find some &5Bedrock&r."
		""
		"&bStep 2:&r Place some &dObsidian&r above it, leaving one block space in between."
		""
		"&bStep 3:&r Throw some &cRedstone Dust&r in the gap left by the &5Bedrock&r and &dObsidian&r."
		""
		"&bStep 4:&r &aLeft-click&r the &dObsidian&r. The &dObsidian&r will crush the &cRedstone Dust&r against the &5Bedrock&r and create &0Flux&r!"
		""
		"There is &nno limit&r to the amount of &cRedstone Dust&r you can use each time."
	]
	quest.356E6E859F0F142A.quest_subtitle: "The key crafting ingredient of the mod"
	quest.356E6E859F0F142A.title: "&fFlux"
