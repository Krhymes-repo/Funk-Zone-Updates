		""
		"This is the functional opposite of the &6ME Export Bus&r."
	]
	quest.6FF505095C13E173.quest_desc: [
		"Inventory Interfaces can be used to gain access to a connected inventory. By placing a Storage Terminal on one you will be able to see all items within the connected system."
